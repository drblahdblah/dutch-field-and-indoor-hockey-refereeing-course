# Copy to .env if you need overrides. No secrets required for local v0.
# All keys use the COURSE_ prefix (see app/config.py).

COURSE_DATABASE_URL=sqlite:///./data/course.db
# Comma-separated allowlist only — do not use * (credentials + CORS reject wildcards)
COURSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COURSE_DEFAULT_LOCALE=nl

# development | production
# production: Secure cookies by default, omit bearer access_token from JSON (cookie-only)
COURSE_ENVIRONMENT=development

# Session TTL in seconds (default 30 days; min 60)
# COURSE_SESSION_TTL_SECONDS=2592000

# Cookie flags (Secure defaults on in production; SameSite=none requires Secure)
# COURSE_COOKIE_SECURE=true
# COURSE_COOKIE_SAMESITE=lax

# Expose access_token in JSON (defaults off in production — cookie-only)
# COURSE_EXPOSE_ACCESS_TOKEN=false

# Per-IP rate limits (window seconds). In-process / single-worker only.
# For multi-worker or multi-replica deploys, enforce limits at the reverse proxy/edge.
# COURSE_RATE_LIMIT_SESSION_CREATE=30
# COURSE_RATE_LIMIT_QUIZ_SUBMIT=120
# COURSE_RATE_LIMIT_WINDOW_SECONDS=60

# Trust X-Forwarded-For (rightmost hop) only behind a proxy that strips spoofed values
# COURSE_TRUST_PROXY=false

# --- Prod-ish checklist (HTTP local demo vs HTTPS) ---
# Local HTTP docker compose prod overlay keeps COURSE_COOKIE_SECURE=false so cookies work.
# On real HTTPS: COURSE_ENVIRONMENT=production, COURSE_COOKIE_SECURE=true,
# COURSE_CORS_ORIGINS=<your SPA origin>, COURSE_EXPOSE_ACCESS_TOKEN=false,
# COURSE_TRUST_PROXY=true only if the proxy sanitizes X-Forwarded-For.
