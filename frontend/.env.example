# Leave empty to use the Vite /api proxy during local `npm run dev`
# (proxy target: http://127.0.0.1:8000 — see vite.config.ts).
#
# Set an absolute API origin when the SPA and API are on different hosts/ports
# (Docker Compose web service, static hosting, prod-ish preview):
# VITE_API_BASE=http://localhost:8000
#
# VITE_* values are public and baked in at `npm run build` time — never put secrets here.
VITE_API_BASE=
